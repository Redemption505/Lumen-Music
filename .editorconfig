root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,xml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom

[*.{cmd,bat}]
end_of_line = crlf

[*.sh]
end_of_line = lf

[desktop/mvnw]
end_of_line = lf
